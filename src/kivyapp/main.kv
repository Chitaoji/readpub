#:kivy 2.3.0
#:import sp kivy.metrics.sp
#:import dp kivy.metrics.dp

<FileImportManagerItem>
    icon: "folder"
    path: ""
    background_normal: ""
    background_down: ""
    dir_or_file_name: ""
    icon_color: 0, 0, 0, 0
    _selected: False
    on_release: root.events_callback(root.path, root)
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerLowColor

    MDListItemLeadingIcon:
        icon: root.icon
        theme_icon_color: "Custom"
        icon_color: root.icon_color

    MDListItemSupportingText:
        text: root.dir_or_file_name
        font_style: "NavText"
        role: "medium"


<FileImportManagerItemPreview>
    name: ""
    path: ""
    realpath: ""
    type: "folder"
    events_callback: lambda x: None
    _selected: False
    orientation: "vertical"
    size_hint_y: None
    height: root.height
    padding: "20dp"
    spacing: "12dp"
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerLowColor

    MDFileManagerThumbnail:
        mipmap: True
        source: root.path
        on_release:
            root.events_callback( \
            os.path.join(root.path if root.type != "folder" \
            else root.realpath, root.name), root)

    MDLabel:
        text: root.name
        adaptive_height: True
        shorten: True
        shorten_from: "center"
        halign: "center"
        text_size: self.width, None


<FIleImportManager>
    canvas:
        Color:
            rgba: app.theme_cls.surfaceContainerLowColor
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        spacing: dp(12)
        padding: 0, 0, 0, dp(4)

        MDBoxLayout:
            id: toolbar
            adaptive_height: True
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.surfaceContainerLowColor

            MDTopAppBarLeadingButtonContainer:
                padding: "12dp", 0, 0, root_label.height / 2 - self.height * 0.35

                MDActionTopAppBarButton:
                    icon: "chevron-left"
                    on_release: root.back()

            MDLabel:
                padding: 0, 0, "12dp", 0
                text: p if (p:=root.current_path) else "此电脑"
                id: root_label
                adaptive_height: True
                font_style: "NavText"
                role: "large"

        RecycleView:
            id: rv
            key_viewclass: "viewclass"
            key_size: "height"
            bar_width: dp(4)
            scroll_wheel_distance: 120
            bar_inactive_color: app.theme_cls.surfaceContainerLowColor

            RecycleGridLayout:
                padding: "10dp"
                spacing: "2dp"
                cols: 3 if root.preview else 1
                default_size: None, dp(48)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height


<BookCard>
    padding: "4dp"
    size_hint: None, None
    size: "480dp", "240dp"

    MDRelativeLayout:
        
        Image:
            source: root.image
            fit_mode: "scale-down"
            pos_hint: {"center_x": .2, "center_y": .5}

        MDIconButton:
            icon: "dots-vertical"
            pos_hint: {"bottom": 1, "right": 1}
            on_release: app.open_cover_menu(self)

        MDIcon:
            icon: "pin" if root.status == "pinned" else ""
            pos_hint: {"top": .98, "right": 1}
            disabled: root.status != "pinned"
        
        MDBoxLayout:
            adaptive_height: True
            orientation: "vertical"
            padding: "190dp", "0dp", "10dp", "0dp"
            pos_hint: {"top": .88}
            spacing: "26dp"
            
            MDLabel:
                text: root.title
                font_style: "BookCover"
                role: "large"
                max_lines: 3
                adaptive_height: True
                pos_hint: {"top": 1}
                
            MDLabel:
                text: root.author
                font_style: "BookCover"
                role: "small"
                color: app.theme_cls.outlineColor
                
        MDLabel:
            text: root.progress
            font_style: "BookCover"
            role: "small"
            color: app.theme_cls.outlineColor
            adaptive_height: True
            padding: "190dp", "0dp", "10dp", "16dp"
            pos_hint: {"bottom": 1}
                

<CoverDropdownTextItem>
    orientation: "vertical"
    
    MDBoxLayout:
        padding: "30dp"
        spacing: 
            (self.width - trailing_text.width)/2 - self.padding[0] \
            - leading_icon.width + dp(10)

        MDIcon:
            id: leading_icon
            icon: root.leading_icon
            pos_hint: {"center_y": .5}
            theme_text_color: "Custom"
            text_color:
                app.theme_cls.onSurfaceVariantColor \
                if not root.leading_icon_color else \
                root.leading_icon_color

        MDLabel:
            id: trailing_text
            text: root.text
            pos_hint: {"center_y": .5}
            theme_text_color: "Custom"
            text_color:
                app.theme_cls.onSurfaceVariantColor \
                if not root.text_color else \
                root.text_color
            adaptive_width: True
            font_style: "BookCover"
            role: "small"

    MDDivider:
        md_bg_color:
            ( \
            app.theme_cls.outlineVariantColor \
            if not root.divider_color \
            else root.divider_color \
            ) \
            if root.divider else \
            (0, 0, 0, 0)

<ColorButton>:
    size: dp(30), dp(30)
    theme_bg_color: "Custom"
    md_bg_color: self.color
    opacity: .5
    on_release: app.switch_theme_palette(self.color.capitalize())

MDScreen:

    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        spacing: "0dp"
        
        MDBoxLayout:
            adaptive_size: True
            padding: "0dp", "70dp", "0dp", "24dp"
            spacing: "20dp"
            pos_hint: {"center_x":.5, "top":1}

            MDIconButton:
                icon: "menu"
                theme_font_size: "Custom"
                font_size: sp(48)
                size: search_field.height, search_field.height
                on_release: app.open_nav_drawer(name="nav_setting")

            MDTextField:
                id: search_field
                mode: "outlined"
                size_hint_x: None
                width: "1380dp"
                height: "240dp"
                radius: 20

                MDTextFieldLeadingIcon:
                    icon: "magnify"

                MDTextFieldHintText:
                    text: "搜索书架"
                    font_style: "BookHint"

                MDTextFieldHelperText:
                    text: "请输入书籍名或作者名..."
                    font_style: "BookHint"

            MDIconButton:
                icon: "plus"
                theme_font_size: "Custom"
                font_size: sp(48)
                size: search_field.height, search_field.height
                on_release: app.open_plus_menu(self)

        MDScrollView:
            do_scroll_x: False
            do_scroll_y: True
            scroll_x: .5
            scroll_type: ["content", "bars"]
            scroll_wheel_distance: 80
            bar_width: "12dp"
            bar_inactive_color: root.theme_cls.backgroundColor
            on_scroll_start: [x.check_border() for x in self.children[0].children]
            on_scroll_stop: [x.check_border() for x in self.children[0].children]

            MDGridLayout:
                id: grid
                cols: 3
                adaptive_size: True
                spacing: ["24dp", "24dp"]
                padding: "24dp"

    MDNavigationLayout:

        MDScreenManager:

        MDNavigationDrawer:
            id: nav_setting
            drawer_type: "modal"
            radius: app.get_radius(root=root, nav="left")[0]
            enable_swiping: False

            MDBoxLayout:
                adaptive_height: True
                orientation: "vertical"
                pos_hint: {"top": 1, "left":1}
                spacing: "20dp"
                
                MDNavigationDrawerLabel:
                    text: "设置"
                    font_style: "NavText"
                    role: "large"

                MDButton:
                    on_release: app.switch_theme_style()
                    adaptive_size: True
                    pos_hint: {"center_x": .5}

                    MDButtonIcon:
                        icon: "theme-light-dark"

                    MDButtonText:
                        text: 
                            "夜间模式" if app.theme_cls.theme_style == "Light" \
                            else "白天模式"
                        font_style: "NavText"
                        role: "medium"

                MDGridLayout:
                    rows: 1
                    padding: 0, dp(5), 0, 0
                    adaptive_width: True
                    spacing: dp(10), 0
                    pos_hint: {"center_x": .5}

                    MDNavigationDrawerLabel:
                        text: "主题颜色"
                        font_style: "NavText"
                        role: "medium"
                        adaptive_width: True
                        padding: 0, 0, 0, dp(4)

                    MDButton:
                        id: palette_now_button
                        size: dp(30), dp(30)
                        theme_bg_color: "Custom"
                        md_bg_color: app.theme_cls.primary_palette.lower()
                        opacity: .5

                MDGridLayout:
                    id: palette_grid_short
                    rows: 1
                    adaptive_width: True
                    padding: 0, dp(40), 0, 0
                    spacing: dp(10), 0
                    pos_hint: {"center_x": .5}

                MDNavigationDrawerDivider:
                    padding: 0, dp(72), 0, 0

                MDButton:
                    on_release: app.reset_theme()
                    adaptive_size: True
                    pos_hint: {"center_x": .5}

                    MDButtonIcon:
                        icon: "restore"

                    MDButtonText:
                        text: "恢复默认"
                        font_style: "NavText"
                        role: "medium"

    MDNavigationLayout:

        MDScreenManager:

        MDNavigationDrawer:
            id: nav_upload
            drawer_type: "modal"
            radius: app.get_radius(root=root, nav="right")[0]
            anchor: "right"
            enable_swiping: False

            MDRelativeLayout:




